<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.JDCK" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_indigo</item>
        <item name="colorPrimaryVariant">@color/brand_indigo_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_teal</item>
        <item name="colorSecondaryVariant">@color/brand_teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- System bars and window. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_indigo_dark</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/brand_indigo_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog"
           parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Dialog</item>
    </style>

    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:foreground">@drawable/ripple_button_filled</item>
        <item name="android:stateListAnimator">@animator/button_press_scale</item>
    </style>

    <style name="AppButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="backgroundTint">@color/button_tint_outlined</item>
        <item name="android:textColor">@color/button_text_outlined</item>
        <item name="android:foreground">@drawable/ripple_button_outlined</item>
        <item name="android:stateListAnimator">@animator/button_press_scale</item>
    </style>

    <style name="AppButton.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="backgroundTint">@color/button_tint_outlined</item>
        <item name="android:textColor">@color/button_text_outlined</item>
        <item name="android:foreground">@drawable/ripple_button_outlined</item>
        <item name="android:stateListAnimator">@animator/button_press_scale</item>
    </style>
</resources>
